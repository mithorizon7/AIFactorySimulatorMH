modules = ["nodejs-22", "web", "postgresql-16"]
run = ["bash", "tools/with-node22.sh", "npm", "run", "dev"]
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]
[env]
HOST = "0.0.0.0"
PUBLIC_HOSTS = "aifactorysimulation.com,ai-factory-mithorizon.replit.app"

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "cloudrun"
build = ["bash", "-c", "bash tools/with-node22.sh npm ci --ignore-scripts && bash tools/with-node22.sh npm run build"]
run = ["bash", "tools/with-node22.sh", "npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Start application"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash tools/with-node22.sh npm ci --ignore-scripts"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash tools/with-node22.sh npm run dev"
waitForPort = 5000

[agent]
integrations = ["javascript_database:1.0.0"]

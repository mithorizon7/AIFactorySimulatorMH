# Retain the observed provider tooling module for the stdlib inspection helper.
# Application build/start use Node; this avoids the same auto-detected Git diff.
modules = ["nodejs-22", "web", "python-base-3.13"]
run = ["bash", "tools/with-node22.sh", "npm", "run", "dev"]
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]
[packager.features]
guessImports = false
enabledForHosting = false

[env]
HOST = "0.0.0.0"
PUBLIC_HOSTS = "aifactorysimulation.com,ai-factory-mithorizon.replit.app"

[nix]
channel = "stable-24_05"

[deployment]
deploymentTarget = "cloudrun"
build = ["bash", "tools/with-node22.sh", "node", "tools/build-release.mjs"]
run = ["bash", "tools/with-node22.sh", "npm", "run", "start"]

[[ports]]
localPort = 5000
externalPort = 80

[workflows]
runButton = "Start application"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash tools/with-node22.sh npm ci --ignore-scripts"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash tools/with-node22.sh npm run dev"
waitForPort = 5000

[userenv]
[userenv.development]
TELEMETRY_ENABLED = "false"
[userenv.production]
TELEMETRY_ENABLED = "false"

# Hostnames only, comma-separated; production startup requires an exact allowlist.
PUBLIC_HOSTS=your-app.replit.app
# Optional development preview hostname. Local development binds loopback by default.
DEV_ALLOWED_HOSTS=
# Set only to verified reverse-proxy CIDRs. Never use a blanket true/hop count.
TRUSTED_PROXIES=
# DATABASE_URL is server-only. Configure in hosting Secrets; never use VITE_ prefix.
DATABASE_URL=

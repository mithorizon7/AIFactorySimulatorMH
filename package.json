{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "dev": "node scripts/assert-node-runtime.mjs && tsx server/index.ts",
    "build": "node scripts/assert-node-runtime.mjs && vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist && node scripts/write-build-metadata.mjs",
    "build:release": "REQUIRE_BUILD_SHA=1 npm run build",
    "start": "node scripts/assert-node-runtime.mjs && NODE_ENV=production node dist/index.js",
    "check:runtime": "node scripts/assert-node-runtime.mjs",
    "check": "tsc",
    "test:e2e": "playwright test",
    "test:e2e:production": "playwright test --config=playwright.production.config.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:regression": "npm run check && npm run test:e2e",
    "test:tutorial": "node --import tsx test_tutorial_availability.ts",
    "test:unit": "vitest run tests/unit",
    "test:api": "vitest run tests/api",
    "test:persistence": "vitest run tests/session tests/unit/contracts/completed-runs.test.ts",
    "test:coverage": "vitest run --coverage",
    "check:bundle": "node scripts/check-bundle-budget.mjs",
    "check:csp:dev": "node --import tsx scripts/check-vite-csp.ts",
    "release:verify": "node scripts/verify-release-truth.mjs",
    "measure:lcp": "node scripts/measure-lcp.mjs",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check README.md docs server shared tests scripts .github/workflows *.config.ts eslint.config.js package.json"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-collapsible": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-separator": "^1.1.0",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-switch": "^1.1.1",
    "@radix-ui/react-tabs": "^1.1.1",
    "@radix-ui/react-toast": "^1.2.19",
    "@radix-ui/react-tooltip": "^1.2.12",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "framer-motion": "^11.18.2",
    "helmet": "^8.2.0",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.516.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "wouter": "^3.7.1",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.4",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.9.0",
    "postcss": "^8.5.31",
    "prettier": "^3.9.5",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.3",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  }
}

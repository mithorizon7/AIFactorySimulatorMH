  "scripts": {
    "dev": "node tools/check-runtime.mjs && tsx server/index.ts",
    "build": "node tools/check-runtime.mjs && vite build && node tools/build-server.mjs",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "tsc",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:regression": "npm run check && npm run test:e2e",
    "test:tutorial": "tsx test_tutorial_availability.ts",
    "test:security": "tsx --test tests/security/*.test.ts && node --test tests/security/*.test.mjs",
    "audit:security": "node tools/check-runtime.mjs && node tools/audit-dependencies.mjs",
    "db:push": "drizzle-kit push",
    "db:migrate-security": "node tools/check-runtime.mjs && node tools/migrate-security.mjs"
  },
